---
import '@styles/global.css';
import '@styles/animations.css';
import '@styles/desktop.css';
import '@styles/lesson.css';
import '@styles/code.css';
import { I18N_CLIENT_SCRIPT } from '@lib/i18n';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description } = Astro.props;
const siteTitle = `${title} — Ligan Java Lab`;
---

<!DOCTYPE html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? 'Aprende Java 21 LTS desde cero — en español latino.'} />
    <meta name="author" content="Carlos Bechara" />
    <meta name="theme-color" content="#1A0D2E" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description ?? 'Plataforma educativa interactiva para aprender Java.'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ligan Java Lab" />

    <!-- Pixel Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <a href="/" class="btn-home" aria-label="Volver al inicio" title="Volver al escritorio principal">
      <span>☕</span>
      <span>Inicio</span>
    </a>
    <slot />
    <script is:inline set:html={I18N_CLIENT_SCRIPT} />
  </body>
  <style>
    .btn-home {
      position: fixed;
      top: 10px;
      left: 10px;
      z-index: 9999;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: #1A0D2E;
      border: 2px solid #DAA520;
      color: #FFD700;
      font-family: var(--font-pixel, 'Press Start 2P', monospace);
      font-size: 10px;
      text-decoration: none;
      box-shadow: 2px 2px 0 rgba(0,0,0,0.5);
      transition: transform 0.1s, box-shadow 0.1s;
      cursor: pointer;
    }
    .btn-home:hover {
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0 rgba(0,0,0,0.5);
    }
    .btn-home:active {
      transform: translate(0, 0);
      box-shadow: 1px 1px 0 rgba(0,0,0,0.5);
    }
  </style>
</html>
