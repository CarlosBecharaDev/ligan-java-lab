---
import Desktop from '../components/desktop/Desktop.astro';
import Taskbar from '../components/desktop/Taskbar.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-container" style="padding-bottom: 48px; height: 100vh; display: flex; flex-direction: column;">
      <Desktop>
        <slot />
      </Desktop>
      <Taskbar />
    </div>
  </body>
</html>
