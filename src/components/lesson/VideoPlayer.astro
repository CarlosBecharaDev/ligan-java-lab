---
export interface Props {
  url?: string;
  title?: string;
  channel?: string;
  duration?: string;
  summary: string;
}

const { url, title, channel, summary } = Astro.props;
---

<div class="video-player" role="region" aria-label="Video recomendado">
  {url ? (
    <div class="video-player__iframe-wrapper">
      <iframe
        src={url}
        title={title ?? 'Video de lección'}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  ) : (
    <div class="video-player__placeholder">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3" /></svg>
      <p>{summary}</p>
    </div>
  )}
  {title && (
    <div class="video-player__info">
      <p class="video-player__title">{title}</p>
      {channel && <p class="video-player__channel">{channel}</p>}
    </div>
  )}
</div>

<style>
  .video-player {
    margin-bottom: var(--space-lg);
  }

  .video-player__iframe-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .video-player__iframe-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-player__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-2xl);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--muted);
    text-align: center;
  }

  .video-player__placeholder svg {
    opacity: 0.5;
  }

  .video-player__info {
    margin-top: var(--space-sm);
  }

  .video-player__title {
    font-weight: 600;
    color: var(--text);
  }

  .video-player__channel {
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
