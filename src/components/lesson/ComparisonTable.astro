---
export interface Props {
  title: string;
  items: Array<{
    name: string;
    features: Record<string, string>;
  }>;
  recommendation: string;
}

const { title, items, recommendation } = Astro.props;
---

<div class="comparison" role="region" aria-label={title}>
  <h3>{title}</h3>
  <table class="comparison-table">
    <thead>
      <tr>
        <th>Característica</th>
        {items.map((item) => <th>{item.name}</th>)}
      </tr>
    </thead>
    <tbody>
      {Object.keys(items[0]?.features ?? {}).map((feature) => (
        <tr>
          <td><strong>{feature}</strong></td>
          {items.map((item) => <td>{item.features[feature]}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
  <div class="comparison-recommendation">
    <strong>Recomendación:</strong> {recommendation}
  </div>
</div>
