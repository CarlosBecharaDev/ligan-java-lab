---
import { getHighlighter } from '@lib/highlighter';

export interface Props {
  code?: string;
  lang?: string;
  title?: string;
}

const { code: propCode, lang = 'java', title } = Astro.props;

let code = propCode ?? '';
if (!code && Astro.slots.has('default')) {
  code = (await Astro.slots.render('default')).trim();
}

// Astro's slot rendering HTML-escapes content (&quot; &#39; &lt; &gt; &amp;).
// We must decode those entities so Shiki receives clean source code.
function unescapeHtml(s: string): string {
  return s
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&');
}

code = unescapeHtml(code);

const codeId = `code-${Math.random().toString(36).slice(2, 8)}`;

function escHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

let highlighted: string;
try {
  const highlighter = await getHighlighter();
  const result = highlighter.codeToTokens(code, { lang: lang as any, theme: 'github-dark-default' });
  const lines = result.tokens;

  var pad = String(lines.length).length;
  const linesHtml = lines.map(function(lineTokens, i) {
    var num = String(i + 1).padStart(pad, ' ');
    var inner = lineTokens.map(function(t) {
      var c = t.color || 'var(--code-shiki-fg)';
      return '<span style="color:' + c + '">' + escHtml(t.content) + '</span>';
    }).join('');
    return '<div class="l"><span class="ln">' + num + '</span>' + inner + '</div>';
  }).join('');

  highlighted = '<div class="s">' + linesHtml + '</div>';
} catch {
  var lines = code.split('\n');
  var pad = String(lines.length).length;
  const fallbackLines = lines.map(function(l, i) {
    var num = String(i + 1).padStart(pad, ' ');
    return '<div class="l"><span class="ln">' + num + '</span>' + escHtml(l) + '</div>';
  }).join('');
  highlighted = '<div class="s">' + fallbackLines + '</div>';
}
---

<div class="code-block" role="region" aria-label={title ?? 'Bloque de código'}>
  <div class="code-block__header">
    <span class="code-block__lang">{lang}</span>
    <div class="code-block__actions">
      <button class="code-block__btn" data-copy={codeId} aria-label="Copiar código" data-i18n-aria="code.copy-aria">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
        <span data-i18n="exercise.copy">Copiar</span>
      </button>
      <button class="code-block__btn" data-download={codeId} aria-label="Descargar .java" data-i18n-aria="exercise.download-aria">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
        <span data-i18n="exercise.download">Descargar</span>
      </button>
    </div>
  </div>
  <div class="code-block__body" set:html={highlighted} />
  <pre hidden aria-hidden="true" data-code-source={codeId}>{code}</pre>
</div>

<script>
  const T = (key: string): string =>
    ((window as any).__i18n && (window as any).__i18n.t(key)) || key;

  document.querySelectorAll('[data-copy]').forEach((btn) => {
    const blockId = btn.getAttribute('data-copy')!;
    const codeEl = document.querySelector(`[data-code-source="${blockId}"]`);

    btn.addEventListener('click', async () => {
      const codigo = codeEl?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(codigo);
        const label = btn.querySelector('span');
        const orig = label ? label.textContent : btn.innerHTML;
        if (label) {
          label.textContent = T('exercise.copied');
        } else {
          btn.innerHTML = T('exercise.copied');
        }
        setTimeout(() => {
          if (label) label.textContent = orig;
          else btn.innerHTML = orig ?? '';
        }, 2000);
      } catch {
        // fallback silencioso
      }
    });
  });

  document.querySelectorAll('[data-download]').forEach((btn) => {
    const blockId = btn.getAttribute('data-download')!;
    const codeEl = document.querySelector(`[data-code-source="${blockId}"]`);

    btn.addEventListener('click', () => {
      const codigo = codeEl?.textContent ?? '';
      const blob = new Blob([codigo], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Ejemplo.java';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  });
</script>
