---
import { createHighlighter } from 'shiki';

export interface Props {
  code?: string;
  lang?: string;
  title?: string;
}

const { code: propCode, lang = 'java', title } = Astro.props;

let code = propCode ?? '';
if (!code && Astro.slots.has('default')) {
  code = (await Astro.slots.render('default')).trim();
}

const codeId = `code-${Math.random().toString(36).slice(2, 8)}`;

function escHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

let highlighted: string;
try {
  const highlighter = await createHighlighter({
    themes: ['github-dark-default'],
    langs: [lang],
  });
  const tokens = highlighter.codeToTokens(code, { lang, theme: 'github-dark-default' });

  const linesHtml = tokens.map(lineTokens => {
    const spans = lineTokens.map(t => {
      const color = t.color || '#e6edf3';
      return `<span style="color:${color}">${escHtml(t.content)}</span>`;
    }).join('');
    return `<span class="line">${spans}</span>`;
  }).join('\n');

  highlighted = `<pre class="shiki github-dark-default" style="background-color:#1A0D2E;color:#e6edf3" tabindex="0"><code>\n${linesHtml}\n</code></pre>`;
} catch {
  highlighted = `<pre class="shiki" style="background-color:#1A0D2E;color:#e6edf3" tabindex="0"><code>\n${code.split('\n').map(l => `<span class="line">${l}</span>`).join('\n')}\n</code></pre>`;
}
---

<div class="code-block" role="region" aria-label={title ?? 'Bloque de código'}>
  <div class="code-block__header">
    <span class="code-block__lang">{lang}</span>
    <div class="code-block__actions">
      <button class="code-block__btn" data-copy={codeId} aria-label="Copiar código">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
        Copiar
      </button>
      <button class="code-block__btn" data-download={codeId} aria-label="Descargar .java">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
        Descargar
      </button>
    </div>
  </div>
  {highlighted}
  <pre hidden aria-hidden="true" data-code-source={codeId}>{code}</pre>
</div>

<script>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    const blockId = btn.getAttribute('data-copy')!;
    const codeEl = document.querySelector(`[data-code-source="${blockId}"]`);

    btn.addEventListener('click', async () => {
      const codigo = codeEl?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(codigo);
        const original = btn.innerHTML;
        btn.innerHTML = '✅ Copiado';
        setTimeout(() => { btn.innerHTML = original; }, 2000);
      } catch {
        // fallback silencioso
      }
    });
  });

  document.querySelectorAll('[data-download]').forEach((btn) => {
    const blockId = btn.getAttribute('data-download')!;
    const codeEl = document.querySelector(`[data-code-source="${blockId}"]`);

    btn.addEventListener('click', () => {
      const codigo = codeEl?.textContent ?? '';
      const blob = new Blob([codigo], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Ejemplo.java';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  });
</script>
