---
export interface Props {
  title: string;
  module: string;
  level: string;
  objectives: string[];
  prerequisites: string[];
}

const { title, module, level, objectives } = Astro.props;
---

<header class="lesson-header">
  <p class="lesson-header__module">{module}</p>
  <h1 class="lesson-header__title">{title}</h1>
  <div class="lesson-header__meta">
    <span class="lesson-header__meta-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z" /></svg>
      <span data-i18n="lesson.level">Nivel:</span> {level}
    </span>
    <span class="lesson-header__meta-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
      {objectives.length} <span data-i18n="lesson.objectives">objetivos</span>
    </span>
  </div>
</header>
