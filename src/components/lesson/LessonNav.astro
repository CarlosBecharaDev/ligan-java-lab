---
export interface Props {
  prevSlug?: string;
  prevTitle?: string;
  nextSlug?: string;
  nextTitle?: string;
}

const { prevSlug, prevTitle, nextSlug, nextTitle } = Astro.props;
---

<nav class="lesson-nav" aria-label="Navegación entre lecciones">
  {prevSlug ? (
    <a href={`/tema/${prevSlug}`} class="lesson-nav__link lesson-nav__link--prev">
      <span class="lesson-nav__label">Anterior</span>
      <span class="lesson-nav__title">{prevTitle}</span>
    </a>
  ) : <div />}
  {nextSlug ? (
    <a href={`/tema/${nextSlug}`} class="lesson-nav__link lesson-nav__link--next">
      <span class="lesson-nav__label">Siguiente</span>
      <span class="lesson-nav__title">{nextTitle}</span>
    </a>
  ) : <div />}
</nav>
