---
export interface ExplorerLesson {
  slug: string;
  id: string;
  title: string;
}

export interface ExplorerModule {
  number: number;
  slug: string;
  title: string;
  lessons: ExplorerLesson[];
}

export interface ExplorerHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  modules: ExplorerModule[];
  currentModuleSlug: string;
  currentSlug: string;
  currentId: string;
  headings?: ExplorerHeading[];
}

const { modules, currentModuleSlug, currentId, headings = [] } = Astro.props;
const visibleHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<nav class="lesson-explorer" id="lesson-explorer" aria-label="Explorador del curso" data-i18n-aria="explorer.aria">
  <p class="lesson-explorer__title" data-i18n="explorer.title">EXPLORADOR</p>

  <ul class="lesson-explorer__tree">
    {modules.map((mod) => {
      const expanded = mod.slug === currentModuleSlug;
      const listId = `explorer-tree-${mod.slug}`;
      return (
        <li class="lesson-explorer__module">
          <button
            type="button"
            class="lesson-explorer__toggle"
            aria-expanded={expanded ? 'true' : 'false'}
            aria-controls={listId}
            data-explorer-toggle
          >
            <span class="lesson-explorer__caret" aria-hidden="true" data-caret>
              {expanded ? '▾' : '▸'}
            </span>
            <span class="lesson-explorer__module-name" title={mod.slug.replace(/-/g, '_').toUpperCase()}>{mod.slug.replace(/-/g, '_').toUpperCase()}</span>
          </button>

          <ul id={listId} class="lesson-explorer__lessons" hidden={!expanded}>
            {mod.lessons.map((lesson) => {
              const isActive = lesson.id === currentId;
              return (
                <li class="lesson-explorer__item">
                  <a
                    href={`/tema/${lesson.id}`}
                    class={`lesson-explorer__link${isActive ? ' lesson-explorer__link--active' : ''}`}
                    aria-current={isActive ? 'page' : undefined}
                    data-slug={lesson.slug}
                  >
                    <span class="lesson-explorer__file" aria-hidden="true"></span>
                    <span class="lesson-explorer__label" title={lesson.title}>{lesson.title}</span>
                    <span class="lesson-explorer__check" aria-hidden="true" data-check></span>
                    <span class="sr-only" data-check-label></span>
                  </a>

                  {isActive && visibleHeadings.length > 0 && (
                    <ul class="lesson-explorer__subsections">
                      {visibleHeadings.map((h) => (
                        <li>
                          <a class="lesson-explorer__subsection" href={`#${h.slug}`} title={h.text}>
                            <span class="lesson-explorer__hash" aria-hidden="true">#</span>
                            <span class="lesson-explorer__subsection-text">{h.text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .lesson-explorer {
    display: flex;
    flex-direction: column;
    width: var(--explorer-width, 240px);
    flex-shrink: 0;
    min-width: 0;
    min-height: 0;
    background: var(--win-bg);
    border-right: 2px solid var(--win-border);
    color: var(--win-text);
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
  }

  .lesson-explorer__title {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--win-muted);
    background: var(--win-bg-alt);
    border-bottom: 1px solid var(--win-border);
    padding: 6px 10px;
    flex-shrink: 0;
  }

  .lesson-explorer__tree,
  .lesson-explorer__module,
  .lesson-explorer__item,
  .lesson-explorer__lessons,
  .lesson-explorer__subsections {
    list-style: none;
    margin: 0;
  }

  .lesson-explorer__tree {
    padding: 4px 0;
    min-width: 0;
  }

  .lesson-explorer__toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 5px 8px;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    letter-spacing: 0.03em;
    color: var(--win-text);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .lesson-explorer__toggle:hover,
  .lesson-explorer__toggle:focus-visible {
    background: rgba(0, 0, 0, 0.06);
    color: var(--win-link);
  }

  .lesson-explorer__caret {
    width: 12px;
    flex-shrink: 0;
    color: var(--win-muted);
    font-size: 0.6rem;
    line-height: 1;
  }

  .lesson-explorer__module-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }

  .lesson-explorer__lessons {
    padding: 0 0 4px;
  }

  .lesson-explorer__lessons[hidden],
  .lesson-explorer__subsections[hidden] {
    display: none;
  }

  .lesson-explorer__link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px 4px 22px;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--win-muted);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .lesson-explorer__link:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--win-text);
    text-decoration: none;
  }

  .lesson-explorer__link--active {
    background: var(--win-bg-alt);
    color: var(--win-text);
    border-left-color: var(--accent);
  }

  .lesson-explorer__file {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: var(--win-link);
    outline: 1px solid var(--win-border);
  }

  .lesson-explorer__link--active .lesson-explorer__file {
    background: var(--accent);
  }

  .lesson-explorer__label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lesson-explorer__check {
    flex-shrink: 0;
    margin-left: auto;
    width: 1.1em;
    text-align: center;
    color: var(--success);
    font-size: 0.9em;
    font-weight: 700;
  }

  .lesson-explorer__subsections {
    padding: 0 0 4px;
  }

  .lesson-explorer__subsection {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px 3px 40px;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--win-muted);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .lesson-explorer__subsection-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lesson-explorer__subsection:hover {
    color: var(--win-link);
    background: rgba(0, 0, 0, 0.05);
    text-decoration: none;
  }

  .lesson-explorer__hash {
    color: var(--win-muted);
    opacity: 0.7;
    flex-shrink: 0;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .lesson-explorer {
      width: 200px;
    }
  }

  @media (max-width: 767px) {
    .lesson-explorer {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(280px, 85vw);
      z-index: 190;
      border-right: 2px solid var(--win-border);
      box-shadow: var(--shadow-lg);
      transform: translateX(-100%);
      transition: transform var(--transition-slow);
    }

    body.explorer-drawer-open .lesson-explorer {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lesson-explorer {
      transition: none;
    }
  }
</style>

<script>
  (function() {
    const nav = document.getElementById('lesson-explorer');
    if (!nav) return;
    const explorer: HTMLElement = nav;

    const KEY = 'ligan-java-lab-progress';

    function loadProgress() {
      try {
        const raw = localStorage.getItem(KEY);
        return raw ? JSON.parse(raw) : { lessons: [] };
      } catch {
        return { lessons: [] };
      }
    }

    function syncChecks() {
      const data = loadProgress();
      const done = new Set(data.lessons || []);
      explorer.querySelectorAll('[data-slug]').forEach((link) => {
        const check = link.querySelector('[data-check]');
        const label = link.querySelector('[data-check-label]');
        const completed = done.has(link.getAttribute('data-slug') || '');
        if (check) check.textContent = completed ? '✓' : '';
        if (label) label.textContent = completed ? 'Completado' : '';
      });
    }

    explorer.querySelectorAll('[data-explorer-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const list = document.getElementById(btn.getAttribute('aria-controls') || '');
        const caret = btn.querySelector('[data-caret]');
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        if (caret) caret.textContent = expanded ? '▸' : '▾';
        if (list) list.hidden = expanded;
      });
    });

    syncChecks();
    document.addEventListener('progress-update', syncChecks);
    window.addEventListener('storage', syncChecks);
  })();
</script>
