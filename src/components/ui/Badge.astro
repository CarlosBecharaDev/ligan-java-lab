---
export interface Props {
  variant?: 'info' | 'success' | 'warning' | 'danger';
}

const { variant = 'info' } = Astro.props;
---

<span class="badge badge--{variant}"><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 2px var(--space-sm);
    font-size: var(--text-xs);
    font-family: var(--font-ui);
    font-weight: normal;
    border-radius: 2px;
    border: 1px solid var(--win-text);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .badge--info {
    background: var(--win-bg);
    color: var(--win-link);
  }

  .badge--success {
    background: var(--win-maximize);
    color: var(--win-text);
  }

  .badge--warning {
    background: var(--win-minimize);
    color: var(--win-text);
  }

  .badge--danger {
    background: var(--win-close);
    color: var(--win-titlebar-text);
  }
</style>
