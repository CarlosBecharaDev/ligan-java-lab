---
export interface Props {
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { padding = 'md', class: className = '' } = Astro.props;
---

<div class:list={['card', `card--${padding}`, className]}><slot /></div>

<style>
  .card {
    background: var(--win-bg);
    color: var(--win-text);
    border: 2px solid var(--win-border);
    border-top-color: var(--win-bevel-bright);
    border-left-color: var(--win-bevel-bright);
    border-bottom-color: var(--win-bevel-dark);
    border-right-color: var(--win-bevel-dark);
    border-radius: 0;
    box-shadow: var(--shadow-sm);
    font-family: var(--font-ui);
  }

  .card--sm {
    padding: var(--space-md);
  }

  .card--md {
    padding: var(--space-lg);
  }

  .card--lg {
    padding: var(--space-xl);
  }
</style>
