---
export interface Props {
  id: string;
  title: string;
  isOpen?: boolean;
}

const { id, title } = Astro.props;
---

<div
  class="modal"
  id={id}
  role="dialog"
  aria-modal="true"
  aria-label={title}
  hidden
>
  <div class="modal__backdrop" data-close-modal={id}></div>
  <div class="modal__content">
    <div class="modal__header">
      <h3 class="modal__title">{title}</h3>
      <button class="modal__close" aria-label="Cerrar" data-i18n-aria="win.close" data-close-modal={id}></button>
    </div>
    <div class="modal__body">
      <slot />
    </div>
  </div>
</div>

<script>
  // Los scripts de Astro son module-scoped; buscamos el modal por data attribute
  document.querySelectorAll('.modal').forEach((modal) => {
    modal.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        modal.hidden = true;
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) {
        modal.hidden = true;
      }
    });
  });
</script>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .modal[hidden] {
    display: none;
  }

  .modal__backdrop {
    position: absolute;
    inset: 0;
    background: var(--surface-strong);
    backdrop-filter: blur(2px);
  }

  .modal__content {
    position: relative;
    width: 100%;
    max-width: 540px;
    max-height: 80vh;
    background: var(--win-bg);
    border: 2px solid var(--win-border-dark);
    border-top-color: var(--win-bevel);
    border-left-color: var(--win-bevel);
    box-shadow: var(--shadow-win);
    display: flex;
    flex-direction: column;
    animation: scaleIn 200ms ease both;
  }

  .modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    background: linear-gradient(90deg, var(--win-titlebar) 0%, var(--win-titlebar-mid) 50%, var(--win-titlebar) 100%);
    min-height: 28px;
  }

  .modal__title {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--win-titlebar-text);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.4);
    margin: 0;
  }

  .modal__close {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--win-close);
    border: 1px solid rgba(0, 0, 0, 0.2);
    cursor: pointer;
    padding: 0;
    transition: opacity var(--transition);
  }

  .modal__close:hover {
    opacity: 0.8;
  }

  .modal__body {
    padding: var(--space-lg);
    overflow-y: auto;
    font-family: var(--font-ui);
    color: var(--win-text);
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }
</style>
