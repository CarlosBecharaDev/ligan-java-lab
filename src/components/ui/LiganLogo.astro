---
export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="ligan-logo" href="/" aria-label="Ligan Java Lab - Inicio" data-i18n-aria="taskbar.logo-aria">
  <svg viewBox="0 0 80 80" role="img" aria-label="Taza de café con símbolos de código" data-i18n-aria="logo.icon-aria">
    <path class="outline" d="M13 20h45v39h-7v8H20v-8h-7z" />
    <path class="cup" d="M18 24h35v31H18z" />
    <path class="shine" d="M22 28h27v5H22zm0 9h10v5H22zm16 0h11v5H38zm-16 9h27v5H22z" />
    <path class="code" d="M25 37h5l-5 5 5 5h-5l-5-5zm20 0h5l5 5-5 5h-5l5-5z" />
    <path class="handle" d="M58 30h9v24h-9v-5h5V35h-5zM20 67h31v5H20z" />
    <path class="steam steam-a" d="M25 13h5v7h-5z" />
    <path class="steam steam-b" d="M42 8h5v12h-5zM40 10h9v5h-9z" />
    <path class="spark spark-a" d="M12 13h5v5h-5z" />
    <path class="spark spark-b" d="M65 15h4v4h-4z" />
  </svg>

  {!compact && <span class="logo-text">
    <strong>LIGAN</strong>
    <small>JAVA LAB</small>
  </span>}
</a>

<style>
  .ligan-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff0c9;
    text-decoration: none;
    font-family: var(--font-pixel, monospace);
    image-rendering: pixelated;
    transition: transform 160ms steps(2), filter 160ms steps(2);
  }

  .ligan-logo svg {
    width: 46px;
    height: 46px;
    filter: drop-shadow(3px 3px 0 #160827);
  }

  .ligan-logo:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0 0 5px #ffd52b);
  }

  .logo-text strong,
  .logo-text small {
    display: block;
    line-height: 0.9;
  }

  .logo-text strong {
    font-size: 20px;
    letter-spacing: 1px;
    text-shadow: 2px 2px #170b2a;
  }

  .logo-text small {
    color: #ffd52b;
    font-size: 9px;
    letter-spacing: 3px;
    margin-top: 5px;
  }

  .outline { fill: #25143e; }
  .cup { fill: #ffd52b; }
  .shine { fill: #fff0c9; }
  .code { fill: #25143e; }
  .handle { fill: #f17bb3; }
  .steam { fill: #8e66d4; }
  .steam-a { animation: steam 1.8s steps(3) infinite; }
  .steam-b { animation-delay: -0.8s; }
  .spark { fill: #fff0c9; }
  .spark-a { animation: sparkle 1.4s steps(2) infinite; }
  .spark-b { animation-delay: -0.6s; }

  @keyframes steam {
    50% { transform: translateY(-4px); opacity: 0.45; }
  }

  @keyframes sparkle {
    50% { opacity: 0.25; transform: scale(1.3); transform-origin: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .steam-a,
    .steam-b,
    .spark-a,
    .spark-b {
      animation: none;
    }

    .ligan-logo {
      transition: none;
    }
  }
</style>
