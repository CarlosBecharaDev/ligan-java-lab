---
export interface Props {
  value: number;
  max?: number;
  label?: string;
  showLabel?: boolean;
}

const { value, max = 100, label, showLabel = true } = Astro.props;
const percentage = Math.min(Math.max((value / max) * 100, 0), 100);
const barId = `progress-${Math.random().toString(36).slice(2, 6)}`;
---

<div class="progress-bar" role="progressbar" aria-valuenow={value} aria-valuemin={0} aria-valuemax={max} aria-labelledby={label ? barId : undefined}>
  {label && <span class="progress-bar__label" id={barId}>{label}</span>}
  <div class="progress-bar__track">
    <div class="progress-bar__fill" style={`width: ${percentage}%`}></div>
  </div>
  {showLabel && <span class="progress-bar__text">{Math.round(percentage)}%</span>}
</div>

<style>
  .progress-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-ui);
  }

  .progress-bar__label {
    font-size: var(--text-sm);
    color: var(--win-text);
    min-width: 80px;
  }

  .progress-bar__track {
    flex: 1;
    height: 16px;
    background: #D4C4A8;
    border: 2px solid;
    border-top-color: var(--win-muted);
    border-left-color: var(--win-muted);
    border-bottom-color: #FFF;
    border-right-color: #FFF;
    overflow: hidden;
  }

  .progress-bar__fill {
    height: 100%;
    background: var(--accent);
    border-right: 2px solid #B8860B;
    transition: width var(--transition-slow);
  }

  .progress-bar__text {
    font-size: var(--text-sm);
    color: var(--win-text);
    min-width: 40px;
    text-align: right;
  }
</style>
