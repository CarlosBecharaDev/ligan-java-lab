---
export interface Props {
  total: number;
  correctas: number;
  nivel: string;
}

const { total, correctas, nivel } = Astro.props;
const porcentaje = total > 0 ? Math.round((correctas / total) * 100) : 0;
---

<div class="quiz-result" role="region" aria-live="polite">
  <p class="quiz-result__score">
    <span class="quiz-result__percentage">{porcentaje}%</span>
  </p>
  <p class="quiz-result__detail">{correctas} de {total} correctas</p>
  <p class="quiz-result__level">
    {nivel === 'excelente' && '🌟 ¡Excelente! Dominas el tema.'}
    {nivel === 'bueno' && '👍 Buen trabajo. Revisa los temas donde fallaste.'}
    {nivel === 'necesita-repasar' && '📚 Vuelve a leer la lección y vuelve a intentarlo.'}
  </p>
</div>
