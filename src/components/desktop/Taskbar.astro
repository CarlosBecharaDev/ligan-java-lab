---
import LiganLogo from '@components/ui/LiganLogo.astro';
import ThemeSelector from './ThemeSelector.astro';
---

<footer class="taskbar" role="toolbar" aria-label="Barra de tareas" data-i18n-aria="taskbar.aria">
  <div class="taskbar__left">
    <LiganLogo compact={false} />
    <ThemeSelector />
  </div>
  
  <div class="taskbar__right">
    <div class="taskbar__lang">
      <button class="taskbar__lang-btn" data-lang-btn="en" onclick="window.__i18n && window.__i18n.setLang('en')">EN</button>
      <button class="taskbar__lang-btn" data-lang-btn="es" onclick="window.__i18n && window.__i18n.setLang('es')">ES</button>
    </div>
    <span class="taskbar__apps"><span data-i18n="nav.apps">Apps</span> (1)</span>
    <span class="taskbar__clock" id="taskbar-clock" aria-label="Reloj" data-i18n-aria="taskbar.clock-aria">
      {new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
    </span>
  </div>
</footer>

<style>
  @media (min-width: 768px) {
    .taskbar .ligan-logo svg {
      width: 20px;
      height: 20px;
    }
    .taskbar .ligan-logo {
      gap: 6px;
      align-items: center;
    }
    .taskbar .logo-text strong,
    .taskbar .logo-text small {
      text-align: center;
    }
    .taskbar .logo-text strong {
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.5px;
    }
    .taskbar .logo-text small {
      font-size: 6px;
      letter-spacing: 1.5px;
      margin-top: 2px;
      line-height: 1;
    }
  }

  @media (max-width: 767px) {
    .taskbar {
      transition: transform 0.3s ease;
      height: 38px;
    }
    .taskbar--hidden {
      transform: translateY(100%);
    }
    .taskbar .ligan-logo svg {
      width: 17px;
      height: 17px;
    }
    .taskbar .ligan-logo {
      gap: 5px;
      align-items: center;
    }
    .taskbar .logo-text strong,
    .taskbar .logo-text small {
      text-align: center;
    }
    .taskbar .logo-text strong {
      font-size: 10px;
      line-height: 1;
      letter-spacing: 0.5px;
    }
    .taskbar .logo-text small {
      font-size: 5px;
      letter-spacing: 1.5px;
      margin-top: 2px;
      line-height: 1;
    }
    .taskbar__right {
      font-size: 0.5rem !important;
    }
    .taskbar__lang-btn {
      font-size: 0.45rem !important;
      padding: 2px 4px !important;
    }
    .taskbar__clock {
      font-size: 0.45rem !important;
    }
  }
</style>

<script>
  function actualizarReloj() {
    const reloj = document.getElementById('taskbar-clock');
    if (reloj) {
      const locale = (window as any).__i18n?.getLang?.() === 'en' ? 'en-US' : 'es-ES';
      reloj.textContent = new Date().toLocaleTimeString(locale, {
        hour: '2-digit',
        minute: '2-digit',
      });
    }
  }
  setInterval(actualizarReloj, 60000);
  actualizarReloj();
  window.addEventListener('lang-change', actualizarReloj);

  // Auto-hide taskbar on scroll for mobile
  const taskbarEl = document.querySelector<HTMLElement>('.taskbar');
  if (taskbarEl && window.innerWidth <= 767) {
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset || document.documentElement.scrollTop;
      if (currentScroll > lastScroll && currentScroll > 50) {
        taskbarEl.classList.add('taskbar--hidden');
      } else {
        taskbarEl.classList.remove('taskbar--hidden');
      }
      lastScroll = currentScroll;
    });
  }
</script>
