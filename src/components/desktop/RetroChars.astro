<div id="retro-chars" class="rc-stage" aria-hidden="true"></div>

<style is:global>
  .rc-stage {
    position: fixed;
    bottom: 48px;
    left: 0;
    right: 0;
    height: 150px;
    z-index: 9999;
    pointer-events: none;
    overflow: visible;
  }

  .rc-char {
    position: absolute;
    bottom: 0;
    pointer-events: none;
  }

  .rc-sprite {
    width: 56px;
    height: 80px;
    position: relative;
    animation: rc-bounce var(--bounce-dur, 0.3s) ease-in-out infinite alternate;
  }

  .rc-pixel {
    position: absolute;
    width: 4px;
    height: 4px;
    image-rendering: pixelated;
  }

  .rc-arm {
    position: absolute;
    width: 8px;
    height: 18px;
    top: 28px;
    border-radius: 3px;
    animation: rc-arm-swing var(--swing-dur, 0.3s) ease-in-out infinite alternate;
  }
  .rc-arm--l { left: -6px; transform-origin: top center; }
  .rc-arm--r { right: -6px; transform-origin: top center; animation-delay: calc(var(--swing-dur, 0.3s) / 2); }

  .rc-bubble {
    position: absolute;
    bottom: 92px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bubble-bg);
    color: var(--bubble-text);
    padding: 10px 16px;
    border-radius: 14px;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(0,0,0,0.35), 3px 3px 0 rgba(0,0,0,0.35);
    border: 2px solid var(--bubble-border);
    opacity: 0;
    transform: translateX(-50%) translateY(6px) scale(0.95);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    z-index: 10;
    text-align: center;
    line-height: 1.4;
    text-shadow: none;
    filter: drop-shadow(0 2px 2px rgba(0,0,0,0.2));
  }

  .rc-bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-top: 10px solid var(--bubble-bg);
    filter: drop-shadow(0 3px 0 var(--bubble-border));
  }

  .rc-bubble--visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  @media (max-width: 767px) {
    .rc-stage { display: none; }
  }

  @keyframes rc-patrol {
    0% { transform: translateX(0); }
    48% { transform: translateX(var(--patrol-dist, 600px)); }
    50% { transform: translateX(var(--patrol-dist, 600px)); }
    98% { transform: translateX(0); }
    100% { transform: translateX(0); }
  }

  @keyframes rc-bounce {
    0% { transform: translateY(0); }
    100% { transform: translateY(-4px); }
  }

  @keyframes rc-arm-swing {
    0% { transform: rotate(-18deg); }
    100% { transform: rotate(18deg); }
  }
</style>

<script>
  (function() {
    interface RetroChar {
      el: HTMLElement;
      bubble: HTMLElement;
      msgIdx: number;
      name: string;
      index: number;
    }

var MSGS: string[] = [];

    try {
      // Elige el idioma de la página (es por defecto, en para /en/).
      var curLang = 'es';
      if (document.documentElement && document.documentElement.getAttribute('data-lang') === 'en') {
        curLang = 'en';
      } else if ((window as any).__i18n && (window as any).__i18n.getLang) {
        curLang = (window as any).__i18n.getLang();
      }
      var tFn = (window as any).__i18n && (window as any).__i18n.t
        ? (window as any).__i18n.t
        : function (_k: string) { return ''; };
      for (var mi = 1; mi <= 51; mi++) {
        var txt = tFn('char.msg' + mi);
        if (txt && txt.indexOf('char.msg') !== 0) MSGS.push(txt);
      }
      if (curLang === 'en' && MSGS.length === 0) {
        // fallback mínimo si el script i18n aún no se expone
        MSGS = ['Keep going!','You can do it','Java is waiting for you'];
      }
      if (MSGS.length === 0) {
        MSGS = ['¡Sigue así!','Tú puedes','Java te espera'];
      }
    } catch (e) {
      MSGS = ['¡Sigue así!','Tú puedes','Java te espera'];
    }

    var SPRITES: Record<string, string[]> = {
      mario: [
        '....RRRR....','...RRRRRR...','...RSSRSS...','..RSSRSSR..',
        '...RRRRRR...','...SSSSSS...','..BBBKBBBB..','.BBBBKBBBBB.',
        'BBBBBKBBBBBB','.BBBBKBBBBB.','..BBBBBBBB..','...BBBBBB...',
        '..NN..NN...','..NN..NN...','.NNNNNNN...','............',
      ],
      scorpion: [
        '....KKKK....','...KKKKKK...','..KYYYYYK..','..KYYYYYK..',
        '..KYYYYYK..','..KYYKYYK..','..KKKKKKK..','.KKKKKKKKK.',
        '.KKK.KK.KK.','KKKKKKKKKKK','KKKKKKKKKKK','.KKKKKKKKK.',
        '..KKKKKKK..','..GG..GG...','.GGGGGGGG..','............',
      ],
      pacman: [
        '....YYYY....','...YYYYYY...','..YYYYYYYY..','..YYYYYYYY..',
        '.YYYYYYYYYY.','.YYYYKYYYYY.','.YYYYYYYYYY.','.YYYYYYYYYY.',
        '..YYYYYYYY..','...YYYYYYY..','....YYYYYY..','.....YYYY...',
        '......YY....','............','............','............',
      ],
      sonic: [
        '....CCCC....','..CCCCCCCC..','.CCCCCCCCCC.','.CCCCCCCCCC.',
        'CCKKCCCCKKCC','CCCCCCCCCCCC','.CCCCCCCCCC.','..CCCCCCCC..',
        '.CCCCCCCCCC.','CCCCCCCCCCCC','.CCCCCCCCCC.','..CRRRRCCCC.',
        '..W..W..W..','.RR..RR..RR.','.RRRRRRRRRR.','............',
      ],
      megaman: [
        '....BBBB....','...BBBBBB...','..CCCCCCCC..','..CCCBCCCC..',
        '..OOOOOOOO..','..OOOOOOOO..','..BBBBBBBB..','.BBBBBBBBBB.',
        'BBBBBBBBBBBB','.BBBBBBBBBB.','..BBBBBBBB..','..DDD..DDD..',
        '..DDD..DDD..','.DDDDDDDDD..','.DDDDDDDDD..','............',
      ],
      wizard: [
        '....PPPP....','...PPPPPP...','..PPPPPPPP..','..PPPPPPPP..',
        '..PPPPPPPP..','..SSSSSSSS..','..SSWWSSWW..','..SSSSSSSS..',
        '..PPPPPPPP..','..PPPPPPPP..','..PPPPPPPP..','..PPPPPPPP..',
        '..PPPPPPPP..','..GG....GG..','..GG....GG..','............',
      ],
    };

    function hex(c: string) {
      var map: Record<string, string> = { R:'#E52521', B:'#1565C0', Y:'#FFD700', K:'#222', W:'#FFF',
                  S:'#FDBF60', G:'#888', O:'#FF8A65', N:'#8D6E63', P:'#7B1FA2',
                  C:'#00BCD4', L:'#64B5F6', D:'#0D47A1' };
      return map[c] || 'transparent';
    }

    const c = document.getElementById('retro-chars');
    if (!c) return;

    var names: string[] = ['mario','scorpion','pacman','sonic','megaman','wizard'];
    var bodyColors: Record<string, string> = { mario:'#1565C0', scorpion:'#222', pacman:'#FFD700', sonic:'#0D47A1', megaman:'#1565C0', wizard:'#7B1FA2' };
    var chars: RetroChar[] = [];
    var INT = 5000;
    // Menos personajes activos a la vez que antes (3 -> 2): con el espacio
    // horizontal ya recortado para no pisar los iconos, mostrar 3 globos a
    // la vez no dejaba aire suficiente y terminaban tapándose entre ellos.
    var ACT = 2;
    var BUBBLE_GAP = 24; // separación mínima en px entre globos activos
    var usedMsgIds: number[] = [];

    // Pre-assign unique starting messages to each char so no repeats at init
    var shuffledMsgs: number[] = [];
    for (var mi = 0; mi < MSGS.length; mi++) shuffledMsgs.push(mi);
    for (var si = shuffledMsgs.length - 1; si > 0; si--) {
      var sj = Math.floor(Math.random() * (si + 1));
      var st = shuffledMsgs[si]; shuffledMsgs[si] = shuffledMsgs[sj]; shuffledMsgs[sj] = st;
    }

    // Evita que los personajes (y sus globos de diálogo) empiecen o patrullen
    // encima de la cuadrícula de iconos del escritorio. La cuadrícula puede
    // partirse en varias columnas según el alto de la ventana, así que su
    // ancho real se mide en tiempo de ejecución en vez de asumir un valor fijo.
    var MAX_PATROL_BUFFER_PX = 160; // cubre patrolDist máximo (140px) + margen
    function safeLeftPercent(): number {
      var grid = document.querySelector('.desktop__grid');
      if (!grid) return 10;
      var gridRect = grid.getBoundingClientRect();
      var stageTop = window.innerHeight - 198; // 48px taskbar + 150px alto del stage
      if (gridRect.bottom <= stageTop) return 10; // la cuadrícula no llega al área de personajes
      var safePx = gridRect.right + MAX_PATROL_BUFFER_PX;
      var safePct = (safePx / window.innerWidth) * 100;
      return Math.min(Math.max(safePct, 10), 60);
    }

    // Spread from a safe left boundary to 88% of viewport width
    var minLeft = safeLeftPercent();
    var step = (88 - minLeft) / names.length;
    var positions: number[] = [];
    for (var pi = 0; pi < names.length; pi++) {
      positions.push(minLeft + pi * step + (Math.random() * 5 - 2.5));
    }

    names.forEach(function(name, i) {
      var el = document.createElement('div');
      el.className = 'rc-char';

      el.style.left = positions[i] + '%';

      // Moderate patrol range (covers area but won't reach neighbors)
      var patrolDist = 50 + Math.random() * 90;
      var patrolSpeed = 25 + Math.random() * 30;
      var bounceDur = (0.2 + Math.random() * 0.25).toFixed(2);
      var swingDur = (0.2 + Math.random() * 0.3).toFixed(2);

      el.style.setProperty('--patrol-dist', patrolDist + 'px');
      el.style.animation = 'rc-patrol ' + patrolSpeed + 's linear infinite';
      el.style.setProperty('--bounce-dur', bounceDur + 's');
      el.style.setProperty('--swing-dur', swingDur + 's');

      if (Math.random() > 0.5) el.style.animationDirection = 'reverse';

      var sp = document.createElement('div');
      sp.className = 'rc-sprite';

      var map = SPRITES[name];
      var px = 4;
      for (var row = 0; row < map.length; row++) {
        for (var col = 0; col < map[row].length; col++) {
          var ch = map[row][col];
          if (ch !== '.') {
            var p = document.createElement('div');
            p.className = 'rc-pixel';
            p.style.left = (col * px) + 'px';
            p.style.top = (row * px) + 'px';
            p.style.background = hex(ch);
            sp.appendChild(p);
          }
        }
      }

      var armL = document.createElement('div');
      armL.className = 'rc-arm rc-arm--l';
      var armR = document.createElement('div');
      armR.className = 'rc-arm rc-arm--r';
      armL.style.background = bodyColors[name] || '#1565C0';
      armR.style.background = bodyColors[name] || '#1565C0';
      sp.appendChild(armL);
      sp.appendChild(armR);

      var bb = document.createElement('div');
      bb.className = 'rc-bubble';
      var msgId = shuffledMsgs[i];
      bb.textContent = MSGS[msgId];
      usedMsgIds.push(msgId);

      el.appendChild(sp);
      el.appendChild(bb);
      c.appendChild(el);

      chars.push({ el:el, bubble:bb, msgIdx:msgId, name:name, index:i });
    });

    function shuffle<T>(a: T[]): T[] {
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
      }
      return a;
    }

    // Los globos se miden por su ancho real ya renderizado (no por la
    // distancia entre personajes), porque el ancho depende del largo del
    // mensaje y el rango horizontal disponible varía según la pantalla.
    // El globo sigue en el DOM con opacity:0 mientras no está activo, así
    // que su tamaño real ya se puede medir antes de mostrarlo.
    function bubbleRect(ch: RetroChar): DOMRect {
      return ch.bubble.getBoundingClientRect();
    }

    function bubblesOverlap(a: RetroChar, b: RetroChar): boolean {
      var ra = bubbleRect(a);
      var rb = bubbleRect(b);
      return ra.right + BUBBLE_GAP >= rb.left && rb.right + BUBBLE_GAP >= ra.left;
    }

    function update() {
      chars.forEach(function(ch) { ch.bubble.classList.remove('rc-bubble--visible'); });

      // Build an index pool of unused messages
      var available: number[] = [];
      for (var mi = 0; mi < MSGS.length; mi++) {
        var taken = false;
        for (var tc = 0; tc < chars.length; tc++) {
          if (chars[tc].msgIdx === mi) { taken = true; break; }
        }
        if (!taken) available.push(mi);
      }

      // Prueba varias combinaciones de personajes + mensajes y se queda con
      // la primera cuyos globos, ya con su ancho real, no se solapen entre
      // sí. Si ninguna combinación calza tras varios intentos, se usa la
      // última probada (degrada con gracia en vez de trabarse).
      var pool = chars.slice();
      var chosen: RetroChar[] = [];
      var chosenMsgIdx: number[] = [];

      for (var attempt = 0; attempt < 30; attempt++) {
        var pick = shuffle(pool.slice()).slice(0, ACT);
        var trialAvailable = available.slice();
        var trialMsgIdx: number[] = [];

        pick.forEach(function(ch) {
          var msgIdx: number;
          if (trialAvailable.length > 0) {
            var ri = Math.floor(Math.random() * trialAvailable.length);
            msgIdx = trialAvailable[ri];
            trialAvailable.splice(ri, 1);
          } else {
            msgIdx = (ch.msgIdx + 1) % MSGS.length;
          }
          trialMsgIdx.push(msgIdx);
          ch.bubble.textContent = MSGS[msgIdx];
        });

        var ok = true;
        for (var a = 0; a < pick.length && ok; a++) {
          for (var b = a + 1; b < pick.length && ok; b++) {
            if (bubblesOverlap(pick[a], pick[b])) ok = false;
          }
        }

        chosen = pick;
        chosenMsgIdx = trialMsgIdx;
        if (ok) break;
      }

      chosen.forEach(function(ch, idx) {
        ch.msgIdx = chosenMsgIdx[idx];
        ch.bubble.textContent = MSGS[ch.msgIdx];
        ch.bubble.classList.add('rc-bubble--visible');
      });
    }

    update();
    setInterval(update, INT);
  })();
</script>
