---
export interface Props {
  label: string;
  icon: string;
  route?: string;
  moduleSlug?: string;
  action?: string;
}

const { label, icon } = Astro.props;
---

<a
  href={Astro.props.route ? Astro.props.route : '/ruta'}
  class="desktop-icon"
  tabindex="0"
  aria-label={`Abrir módulo ${label}`}
  role="button"
>
  <div class="desktop-icon__graphic" aria-hidden="true">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    </svg>
  </div>
  <span class="desktop-icon__label" data-i18n={`icon.${label}`}>{label}</span>
</a>
