---
import LiganLogo from '@components/ui/LiganLogo.astro';
import ThemeSelector from './ThemeSelector.astro';
import { localePrefix } from '@lib/course';

const { lang = 'es' } = Astro.props;
const P = localePrefix(lang);
---

<div class="win" role="dialog" aria-label="JAVA_WORKSPACE" aria-modal="true" data-i18n-aria="home.title">
  <div class="win__titlebar">
    <span class="win__title">JAVA_WORKSPACE</span>
    <div class="win__controls">
      <button class="win__btn" aria-label="Minimizar" data-i18n-aria="win.minimize"></button>
      <button class="win__btn" aria-label="Maximizar" data-i18n-aria="win.maximize"></button>
      <button class="win__btn win__btn--close" aria-label="Cerrar" data-i18n-aria="win.close"></button>
    </div>
  </div>

  <div class="win__body">

    <nav class="sidebar">
      <div class="sidebar__brand">
        <LiganLogo />
      </div>
      <ul class="sidebar__menu">
        <li><a href={`${P}/`} class="sidebar__link sidebar__link--active"><span class="sidebar__icon" aria-hidden="true">⌂</span><span data-i18n="nav.home">Inicio</span></a></li>
        <li><a href={`${P}/ruta`} class="sidebar__link"><span class="sidebar__icon" aria-hidden="true">☰</span><span data-i18n="nav.modules">Módulos</span></a></li>
        <li><a href={`${P}/practica`} class="sidebar__link"><span class="sidebar__icon" aria-hidden="true">⚡</span><span data-i18n="nav.code-lab">Code Lab</span></a></li>
        <li><a href={`${P}/progreso`} class="sidebar__link"><span class="sidebar__icon" aria-hidden="true">📊</span><span data-i18n="nav.progress">Progreso</span></a></li>
        <li><a href={`${P}/recursos`} class="sidebar__link"><span class="sidebar__icon" aria-hidden="true">📖</span><span data-i18n="nav.resources">Recursos</span></a></li>
      </ul>
    </nav>

    <div class="mobile-brand">
      <LiganLogo />
    </div>

    <main class="main">
      <div class="main__top">
        <span class="streak">🔥 3 <span data-i18n="home.days">DÍAS</span></span>
      </div>

      <div class="main__content">
        <div class="main__welcome">
          <h1 class="main__heading" data-i18n="home.keep-learning">Sigue aprendiendo.</h1>
        </div>

        <div class="lesson-card">
          <span class="lesson-card__module" data-i18n="home.card-module">Módulo 02 · Fundamentos</span>
          <h2 class="lesson-card__title" data-i18n="home.card-title">Variables y tipos</h2>
          <p class="lesson-card__desc" data-i18n="home.card-desc">Declaración, inicialización y tipos primitivos en Java.</p>
          <div class="lesson-card__progress">
            <div class="progress-bar">
              <div class="progress-bar__fill"></div>
            </div>
            <span class="progress-bar__label">43% <span data-i18n="home.percent-complete">completado</span></span>
          </div>
          <div class="lesson-card__meta">
            <span class="lesson-card__duration" data-i18n="home.card-duration">⏱ 15 min</span>
            <a href={`${P}/tema/variables-y-tipos`} class="cta-btn" data-i18n="home.continue">CONTINUAR →</a>
          </div>
        </div>

        <div class="challenge">
          <span class="challenge__icon">✦</span>
          <span class="challenge__text" data-i18n="home.challenge">Reto del día · Declara una variable · <strong>+50 XP</strong></span>
          <a href={`${P}/tema/variables-y-tipos#ejercicios`} class="challenge__link" data-i18n="home.start">Iniciar →</a>
        </div>
      </div>
    </main>

  </div>

    <nav class="bottom-nav" aria-label="Navegación móvil" data-i18n-aria="nav.mobile-aria">
    <div class="bottom-nav__links">
      <a href={`${P}/`} class="bottom-nav__link bottom-nav__link--active"><span data-i18n="nav.home">Inicio</span></a>
      <a href={`${P}/ruta`} class="bottom-nav__link"><span data-i18n="nav.modules">Módulos</span></a>
      <a href={`${P}/practica`} class="bottom-nav__link"><span data-i18n="nav.lab">Lab</span></a>
      <a href={`${P}/progreso`} class="bottom-nav__link"><span data-i18n="nav.progress">Progreso</span></a>
    </div>
    <div class="bottom-nav__tools">
      <div class="bottom-nav__theme"><ThemeSelector /></div>
      <div class="bottom-nav__lang">
        <button class="bottom-nav__lang-btn" data-lang-btn="en" onclick="window.__i18n && window.__i18n.setLang('en')">EN</button>
        <button class="bottom-nav__lang-btn" data-lang-btn="es" onclick="window.__i18n && window.__i18n.setLang('es')">ES</button>
      </div>
      <span class="bottom-nav__clock" id="bottom-nav-clock" aria-label="Reloj" data-i18n-aria="taskbar.clock-aria">
        {new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
      </span>
    </div>
  </nav>
</div>

<style>
  /* ========================================================================
     MainWindow — retro pixel-art ventana principal
     ======================================================================== */

  .win {
    position: fixed;
    display: flex;
    flex-direction: column;
    background: var(--win-bg);
    border: 2px solid var(--win-border-dark);
    border-top-color: var(--win-bevel);
    border-left-color: var(--win-bevel);
    box-shadow: var(--shadow-win);
    overflow: hidden;
    z-index: var(--z-window);
    animation: winOpen 200ms ease both;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 590px);
    max-height: 85vh;
  }

  @keyframes winOpen {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.95); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  /* --- Titulo --- */
  .win__titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px;
    background: linear-gradient(90deg, var(--win-titlebar) 0%, var(--win-titlebar-mid) 50%, var(--win-titlebar) 100%);
    user-select: none;
    min-height: 28px;
  }

  .win__title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--win-titlebar-text);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win__controls {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .win__btn {
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.2);
    transition: opacity var(--transition);
    padding: 0;
  }

  .win__btn:first-child { background: var(--win-minimize); }
  .win__btn:nth-child(2) { background: var(--win-maximize); }
  .win__btn--close { background: var(--win-close); }
  .win__btn:hover { opacity: 0.8; }

  /* --- Cuerpo: sidebar + main --- */
  .win__body {
    flex: 1;
    display: flex;
    overflow: hidden;
    background: var(--win-bg);
    color: var(--win-text);
    font-family: var(--font-ui);
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  /* --- Sidebar --- */
  .sidebar {
    width: 160px;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    background: rgba(0, 0, 0, 0.35);
    border-right: 2px solid var(--win-border);
    padding: var(--space-md) var(--space-sm);
    gap: var(--space-lg);
  }

  .sidebar__brand {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--win-border);
  }

  .sidebar__brand .ligan-logo svg {
    width: 40px;
    height: 40px;
  }

  .sidebar__brand .logo-text strong {
    font-size: 16px;
  }

  .sidebar__brand .logo-text small {
    font-size: 7px;
    letter-spacing: 2px;
    margin-top: 4px;
  }

  .mobile-brand {
    display: none;
  }

  .mobile-brand .ligan-logo {
    color: var(--win-text);
  }

  .mobile-brand .logo-text strong {
    color: var(--win-text);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.12);
  }

  .mobile-brand .logo-text small {
    color: var(--brand-accent);
  }

  .bottom-nav {
    display: none;
  }

  .bottom-nav__tools {
    display: none;
  }

  .sidebar__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar__link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--win-muted);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background var(--transition), color var(--transition);
    border-radius: var(--radius-sm);
  }

  .sidebar__icon {
    flex-shrink: 0;
    width: 1.4em;
    text-align: center;
    filter: grayscale(1) brightness(1.5);
    font-style: normal;
  }

  .sidebar__link:hover .sidebar__icon,
  .sidebar__link--active .sidebar__icon {
    filter: grayscale(1) brightness(2);
  }

  .sidebar__link:hover {
    background: rgba(255, 215, 0, 0.1);
    color: var(--win-text);
    text-decoration: none;
  }

  .sidebar__link--active {
    background: rgba(255, 215, 0, 0.12);
    color: var(--brand-accent);
    border-color: var(--win-border);
    font-weight: 600;
  }

  /* --- Main area --- */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    overflow-y: auto;
    gap: var(--space-md);
  }

  .main__top {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .streak {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--xp);
    padding: 4px 8px;
    border: 1px solid var(--win-border);
    background: rgba(255, 215, 0, 0.05);
  }

  .main__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-lg);
  }

  .main__heading {
    font-family: var(--font-pixel);
    font-size: var(--text-xl);
    color: var(--win-text);
    margin: var(--space-xs) 0 0;
    line-height: 1.2;
  }

  /* --- Lesson card --- */
  .lesson-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 2px solid var(--win-border);
    background: var(--win-bg);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15);
  }

  .lesson-card__module {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--brand-accent);
    letter-spacing: 0.05em;
  }

  .lesson-card__title {
    font-family: var(--font-pixel);
    font-size: var(--text-base);
    color: var(--win-text);
    margin: 0;
    line-height: 1.3;
  }

  .lesson-card__desc {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--win-muted);
    margin: 0;
  }

  .lesson-card__progress {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .progress-bar {
    flex: 1;
    height: 10px;
    background: rgba(0, 0, 0, 0.08);
    border: 1px solid var(--win-border);
    position: relative;
    overflow: hidden;
  }

  .progress-bar__fill {
    height: 100%;
    width: 43%;
    background: repeating-linear-gradient(
      135deg,
      var(--brand-accent) 0 6px,
      var(--brand-accent-2) 6px 12px
    );
    animation: progressFill 7s steps(14) infinite alternate;
  }

  @keyframes progressFill {
    from { width: 43%; }
    to { width: 67%; }
  }

  .progress-bar__label {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--win-muted);
    white-space: nowrap;
  }

  .lesson-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .lesson-card__duration {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--win-muted);
    border: 1px solid var(--win-border);
    background: var(--win-bg-alt);
    white-space: nowrap;
  }

  .cta-btn {
    display: inline-block;
    padding: 8px 20px;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    color: var(--win-bg);
    background: var(--brand-accent);
    border: 2px solid transparent;
    border-top-color: var(--brand-accent-light);
    border-left-color: var(--brand-accent-light);
    border-bottom-color: var(--brand-accent-dark);
    border-right-color: var(--brand-accent-dark);
    text-decoration: none;
    cursor: pointer;
    animation: btnPulse 2.4s steps(4) infinite;
    transition: filter var(--transition);
  }

  .cta-btn:hover {
    filter: brightness(1.15);
    text-decoration: none;
  }

  @keyframes btnPulse {
    0%, 100% { box-shadow: 0 0 0 var(--brand-glow); }
    50% { box-shadow: 0 0 6px var(--brand-glow); }
  }

  /* --- Challenge --- */
  .challenge {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--win-border);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--win-muted);
  }

  .challenge__icon {
    color: var(--brand-accent);
    font-size: var(--text-sm);
  }

  .challenge__text strong {
    color: var(--xp);
    font-weight: 600;
  }

  .challenge__link {
    margin-left: auto;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--win-link);
    text-decoration: none;
    white-space: nowrap;
  }

  .challenge__link:hover {
    text-decoration: underline;
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .win { animation: none; }
    .progress-bar__fill { animation: none; width: 43%; }
    .cta-btn { animation: none; }
  }

  /* --- Mobile --- */
  @media (max-width: 767px) {
    .win {
      position: fixed;
      inset: 0;
      width: 100% !important;
      height: 100% !important;
      max-height: 100vh !important;
      transform: none !important;
      border-radius: 0;
      padding-bottom: 52px;
      z-index: calc(var(--z-taskbar) + 1);
    }

    .win__titlebar {
      cursor: default;
    }

    .sidebar {
      display: none;
    }

    .mobile-brand {
      display: flex;
      justify-content: center;
      padding: var(--space-sm) var(--space-sm) var(--space-xs);
      border-bottom: 1px solid var(--win-border);
    }

    .win__body {
      flex-direction: column;
      overflow-y: auto;
    }

    .main {
      padding: var(--space-md);
    }

    .main__heading {
      font-size: var(--text-lg);
    }

    .streak {
      font-size: 0.45rem;
    }

    .lesson-card__meta {
      flex-wrap: wrap;
    }

    .challenge {
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .challenge__link {
      margin-left: 0;
    }

    .bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 0 6px;
      background: var(--taskbar-bg);
      border-top: 2px solid var(--taskbar-separator);
      box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.5);
      z-index: var(--z-taskbar);
    }

    .bottom-nav__links {
      display: flex;
      align-items: center;
      justify-content: space-evenly;
      gap: 2px;
      min-width: 0;
      flex: 1;
    }

    .bottom-nav__link {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3px 2px;
      font-family: var(--font-pixel);
      font-size: 0.34rem;
      color: var(--taskbar-text);
      text-decoration: none;
      border: 1px solid transparent;
      transition: background var(--transition), color var(--transition);
      white-space: nowrap;
    }

    .bottom-nav__link span {
      font-size: 0.34rem;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .bottom-nav__link:hover {
      background: rgba(255, 215, 0, 0.1);
      color: var(--taskbar-active);
      border-color: var(--taskbar-separator);
      text-decoration: none;
    }

    .bottom-nav__link--active {
      background: rgba(255, 215, 0, 0.15);
      color: var(--taskbar-active);
      border-color: var(--taskbar-separator);
    }

    .bottom-nav__tools {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      flex-shrink: 0;
    }

    .bottom-nav__theme .theme-btn {
      min-height: 30px;
      width: 30px;
      padding: 0;
      justify-content: center;
      font-size: 0.4rem;
    }

    .bottom-nav__theme .theme-btn__label,
    .bottom-nav__theme .theme-btn__caret {
      display: none;
    }

    .bottom-nav__theme .theme-btn__icon {
      font-size: 0.6rem;
    }

    .bottom-nav__lang {
      display: flex;
      gap: 2px;
    }

    .bottom-nav__lang-btn {
      padding: 3px 5px;
      font-family: var(--font-pixel);
      font-size: 0.4rem;
      color: var(--taskbar-text);
      border: 1px solid var(--taskbar-border);
      background: none;
      cursor: pointer;
      transition: all var(--transition);
    }

    .bottom-nav__lang-btn:hover,
    .bottom-nav__lang-btn.active {
      background: var(--taskbar-active);
      color: var(--btn-primary-text);
      border-color: var(--taskbar-active);
    }

    .bottom-nav__clock {
      font-family: var(--font-ui);
      font-size: 0.5rem;
      color: var(--taskbar-text);
      padding: 3px 4px;
      border-left: 1px solid var(--taskbar-border);
    }
  }
</style>

<script>
  function actualizarRelojNav() {
    const reloj = document.getElementById('bottom-nav-clock');
    if (reloj) {
      const locale = (window as any).__i18n?.getLang?.() === 'en' ? 'en-US' : 'es-ES';
      reloj.textContent = new Date().toLocaleTimeString(locale, {
        hour: '2-digit',
        minute: '2-digit',
      });
    }
  }
  setInterval(actualizarRelojNav, 60000);
  actualizarRelojNav();
  window.addEventListener('lang-change', actualizarRelojNav);
</script>
