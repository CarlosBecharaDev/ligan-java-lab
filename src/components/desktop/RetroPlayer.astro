---
// src/components/desktop/RetroPlayer.astro
// Reproductor de Spotify con skin inspirado en Windows Media Player clásico.
import { SkipBack, Play, Pause, SkipForward, Volume2, Minus, FileText } from 'lucide-astro';
---
<div id="retro-player" class="wmp-player" aria-label="Reproductor de Spotify">
  <!-- Barra de título estilo WMP (arrástrala para mover el reproductor) -->
  <div class="wmp-titlebar" data-wmp-drag>
    <span class="wmp-title">Reproductor de Spotify</span>
    <div class="wmp-title-actions">
      <button id="wmp-lyrics-btn" type="button" aria-label="Mostrar letra" aria-pressed="false" title="Letra">
        <FileText size={14} />
      </button>
      <button id="wmp-collapse" type="button" aria-label="Minimizar reproductor"><Minus size={14} /></button>
    </div>
  </div>

  <div id="wmp-body" class="wmp-body">
    <!-- Estado de conexión -->
    <div id="wmp-connect-panel" class="wmp-panel">
      <p class="wmp-msg">Conecta tu cuenta de Spotify para reproducir música.</p>
      <button id="wmp-connect-btn" type="button" class="wmp-btn-primary">
        Conectar con Spotify
      </button>
    </div>

    <!-- Panel principal (oculto hasta conectar) -->
    <div id="wmp-main-panel" class="wmp-panel hidden">
      <div class="wmp-user-row">
        <span id="wmp-username">—</span>
        <span id="wmp-plan" class="wmp-plan-badge">—</span>
        <button id="wmp-disconnect-btn" type="button" aria-label="Desconectar cuenta de Spotify">
          Desconectar
        </button>
      </div>

      <div class="wmp-nowplaying">
        <div class="wmp-art-frame">
          <img id="wmp-art" alt="" src="" class="hidden" />
          <div id="wmp-art-placeholder" class="wmp-art-placeholder" aria-hidden="true"></div>
        </div>
        <div class="wmp-track-info">
          <p id="wmp-track-name" class="wmp-track-name">Sin reproducción</p>
          <p id="wmp-artist-name" class="wmp-artist-name"></p>
          <p id="wmp-device-name" class="wmp-device-name"></p>
        </div>
      </div>

      <!-- Panel de letras sincronizadas -->
      <div id="wmp-lyrics-panel" class="wmp-lyrics hidden" aria-live="off">
        <p id="wmp-lyrics-status" class="wmp-lyrics-status">Cargando letra...</p>
        <ol id="wmp-lyrics-body" class="wmp-lyrics-body"></ol>
      </div>

      <!-- Barra de progreso -->
      <div class="wmp-progress-row">
        <span id="wmp-time-current" class="wmp-time">0:00</span>
        <input
          id="wmp-progress"
          type="range"
          min="0"
          max="1000"
          value="0"
          aria-label="Progreso de la canción"
        />
        <span id="wmp-time-total" class="wmp-time">0:00</span>
      </div>

      <!-- Controles de transporte -->
      <div class="wmp-controls">
        <button id="wmp-prev" type="button" aria-label="Canción anterior"><SkipBack size={16} /></button>
        <button id="wmp-playpause" type="button" aria-label="Reproducir">
          <span id="wmp-icon-play"><Play size={18} /></span>
          <span id="wmp-icon-pause" class="hidden"><Pause size={18} /></span>
        </button>
        <button id="wmp-next" type="button" aria-label="Siguiente canción"><SkipForward size={16} /></button>
        <div class="wmp-volume">
          <label for="wmp-volume-slider" class="visually-hidden">Volumen</label>
          <span aria-hidden="true" class="wmp-volume-icon"><Volume2 size={14} /></span>
          <input id="wmp-volume-slider" type="range" min="0" max="100" value="70" aria-label="Volumen" />
        </div>
      </div>

      <!-- Mensaje de estado (errores / avisos) -->
      <p id="wmp-status" class="wmp-status hidden" role="status"></p>

      <!-- Búsqueda -->
      <div class="wmp-search">
        <label for="wmp-search-input" class="visually-hidden">Buscar canciones</label>
        <input
          id="wmp-search-input"
          type="text"
          placeholder="Buscar canción o artista..."
          aria-label="Buscar canciones por artista o título"
        />
        <ul id="wmp-search-results" class="wmp-search-results" aria-label="Resultados de búsqueda"></ul>
      </div>
    </div>
  </div>
</div>

<!-- Botón flotante de música: muestra/oculta el reproductor (móvil) -->
<button id="wmp-fab" type="button" class="wmp-fab hidden" aria-label="Mostrar reproductor de Spotify">
  <svg viewBox="0 0 16 16" width="22" height="22" fill="none" shape-rendering="crispEdges" aria-hidden="true">
    <rect x="10" y="1" width="2" height="11" fill="#fff"/>
    <rect x="11" y="1" width="3" height="2" fill="#fff"/>
    <rect x="4" y="9" width="4" height="4" fill="#1ed760"/>
    <rect x="3" y="10" width="4" height="2" fill="#1ed760"/>
    <rect x="4" y="13" width="3" height="1" fill="#1ed760"/>
    <rect x="3" y="9" width="1" height="1" fill="#2a2a2a"/>
  </svg>
</button>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .hidden {
    display: none !important;
  }

  .wmp-player {
    --wmp-green: #1ed760;
    --wmp-warn: #ffd700;
    --wmp-bg: #0a0a0a;
    --wmp-error: #ff5f57;

    position: fixed;
    top: 12px;
    right: 12px;
    width: 270px;
    max-width: 280px;
    z-index: 500;
    font-family: "Perfect DOS VGA 437", "MS Sans Serif", monospace;
    border: 2px solid #000;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.6);
    background: var(--wmp-bg);
    color: #e6e6e6;
    image-rendering: pixelated;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    transform-origin: center;
  }

  /* Estado oculto: usa visibility (mantiene las dimensiones medibles) y
     anima la aparición/desaparición en vez de cortarse bruscamente. */
  .wmp-player--hide {
    opacity: 0;
    transform: scale(0.92) translateY(6px);
    visibility: hidden;
    pointer-events: none;
  }

  /* Barra de título tipo WMP (chrome azul con bisel) */
  .wmp-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3px 6px;
    background: linear-gradient(180deg, #be6cb0 0%, #a85499 50%, #803878 100%);
    border-bottom: 2px solid #000;
    cursor: move;
    touch-action: none;
    user-select: none;
  }
  .wmp-title {
    font-size: 11px;
    color: #fff;
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wmp-title-actions button {
    background: #c0c0c0;
    border: 1px solid #000;
    color: #000;
    font-size: 10px;
    width: 16px;
    height: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .wmp-body {
    padding: 8px;
    max-height: calc(100vh - 90px);
    overflow-y: auto;
  }

  .wmp-panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wmp-msg {
    font-size: 11px;
    color: var(--wmp-warn);
    margin: 0;
  }

  .wmp-btn-primary {
    background: var(--wmp-green);
    color: #000;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
    padding: 6px 8px;
    font-family: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .wmp-btn-primary:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--wmp-warn);
    outline-offset: 2px;
  }

  .wmp-user-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 10px;
  }
  #wmp-username {
    font-weight: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100px;
  }
  .wmp-plan-badge {
    background: var(--wmp-green);
    color: #000;
    padding: 1px 4px;
    font-size: 9px;
    text-transform: uppercase;
  }
  #wmp-disconnect-btn {
    margin-left: auto;
    background: #1a1a1a;
    color: var(--wmp-error);
    border: 1px solid var(--wmp-error);
    font-size: 9px;
    cursor: pointer;
    padding: 2px 5px;
  }

  .wmp-nowplaying {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .wmp-art-frame {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    background: radial-gradient(circle at 30% 30%, #3a1f5c, #0a0a0a 70%);
    border: 2px solid #000;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }
  .wmp-art-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wmp-art-placeholder {
    width: 100%;
    height: 100%;
  }

  .wmp-track-info {
    min-width: 0;
    flex: 1;
  }
  .wmp-track-name,
  .wmp-artist-name,
  .wmp-device-name {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wmp-track-name {
    font-size: 11px;
    color: var(--wmp-green);
    font-weight: bold;
  }
  .wmp-artist-name {
    font-size: 10px;
    color: #ccc;
  }
  .wmp-device-name {
    font-size: 9px;
    color: #888;
  }

  .wmp-lyrics {
    border: 1px solid #333;
    background: #050505;
    max-height: 132px;
    overflow-y: auto;
    padding: 4px 6px;
  }
  .wmp-lyrics-status {
    margin: 0;
    font-size: 9px;
    color: #888;
    white-space: pre-wrap;
  }
  .wmp-lyrics-body {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wmp-lyric-line {
    padding: 3px 2px;
    font-size: 10px;
    line-height: 1.35;
    color: #9b9b9b;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .wmp-lyric-line.active {
    color: var(--wmp-green);
    font-weight: bold;
    background: rgba(30, 215, 96, 0.08);
  }
  #wmp-lyrics-btn[aria-pressed="true"] {
    background: var(--wmp-green);
    color: #000;
  }

  .wmp-progress-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .wmp-time {
    font-size: 9px;
    color: #aaa;
    width: 28px;
  }
  #wmp-progress {
    flex: 1;
    min-width: 0;
    accent-color: var(--wmp-green);
  }

  .wmp-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .wmp-controls button {
    background: #1a1a1a;
    color: #fff;
    border: 2px solid #444;
    box-shadow: 1px 1px 0 #000;
    width: 28px;
    height: 24px;
    cursor: pointer;
    font-size: 11px;
    display: grid;
    place-items: center;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }
  .wmp-controls button:hover {
    border-color: #888;
    transform: translateY(-1px);
  }
  .wmp-controls button:active {
    transform: translateY(1px);
    box-shadow: none;
  }
  #wmp-playpause {
    border-color: var(--wmp-green);
    color: var(--wmp-green);
    background: #0d1f14;
  }
  #wmp-playpause:hover {
    border-color: var(--wmp-green);
    color: #2af57e;
    background: #12331f;
    box-shadow: 0 0 8px rgba(30, 215, 96, 0.35);
  }
  .wmp-volume {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .wmp-volume-icon {
    display: grid;
    place-items: center;
    color: #aaa;
  }
  .wmp-volume input {
    width: 60px;
    accent-color: var(--wmp-green);
  }

  .wmp-status {
    font-size: 10px;
    color: var(--wmp-warn);
    background: #1a1a1a;
    border: 1px solid var(--wmp-warn);
    padding: 4px 6px;
    margin: 0;
  }
  .wmp-status[data-kind="error"] {
    color: var(--wmp-error);
    border-color: var(--wmp-error);
  }

  .wmp-search input {
    width: 100%;
    box-sizing: border-box;
    background: #000;
    color: #fff;
    border: 1px solid #444;
    font-family: inherit;
    font-size: 10px;
    padding: 4px;
  }
  .wmp-search-results {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    max-height: 130px;
    overflow-y: auto;
    border: 1px solid #333;
  }
  .wmp-search-results li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 4px;
    font-size: 9px;
    border-bottom: 1px solid #222;
    cursor: pointer;
  }
  .wmp-search-results li:hover,
  .wmp-search-results li:focus-visible {
    background: #1a2f1e;
  }
  .wmp-search-results .wmp-result-title {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- Botón flotante de música (mostrar/ocultar en móvil) --- */
  .wmp-fab {
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 510;
    width: 44px;
    height: 44px;
    border-radius: 0;
    border: 2px solid #000;
    border-top-color: #c0c0c0;
    border-left-color: #c0c0c0;
    border-bottom-color: #444;
    border-right-color: #444;
    background: linear-gradient(180deg, #be6cb0 0%, #a85499 50%, #803878 100%);
    color: #fff;
    font-family: "Perfect DOS VGA 437", "MS Sans Serif", monospace;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.6);
    display: grid;
    place-items: center;
    image-rendering: pixelated;
    touch-action: none;
  }
  .wmp-fab:active {
    border-top-color: #444;
    border-left-color: #444;
    border-bottom-color: #c0c0c0;
    border-right-color: #c0c0c0;
    box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
    transform: translate(1px, 1px);
  }
  .wmp-fab:focus-visible {
    outline: 2px solid var(--wmp-warn);
    outline-offset: 2px;
  }
  .wmp-fab.pulse {
    animation: wmp-fab-pulse 1.6s ease-in-out infinite;
  }
  @keyframes wmp-fab-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(30, 215, 96, 0.5); }
    50% { box-shadow: 0 0 0 8px rgba(30, 215, 96, 0); }
  }

  /* --- Responsive móvil --- */
  @media (max-width: 640px) {
    .wmp-player {
      top: auto;
      bottom: calc(48px + env(safe-area-inset-bottom, 0px));
      right: 6px;
      left: 6px;
      width: auto;
      max-width: 200px;
      margin-left: auto;
      max-height: calc(100dvh - 72px);
    }
    .wmp-body {
      max-height: calc(100dvh - 120px);
    }
    .wmp-fab {
      top: auto;
      right: 10px;
      bottom: calc(58px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

<script>
  import {
    isConnected,
    startLogin,
    logout,
    getMe,
    getPlaybackState,
    play,
    pause,
    nextTrack,
    previousTrack,
    seek,
    setVolume,
    searchTracks,
    SpotifyAppError,
  } from "@lib/spotify";
  import type { PlaybackState } from "@lib/spotify";
  import { getSyncedLyrics } from "@lib/lyrics";
  import type { LyricLine } from "@lib/lyrics";

  const $ = <T extends Element = HTMLElement>(sel: string) =>
    document.querySelector<T>(sel)!;

  const connectPanel = $("#wmp-connect-panel");
  const mainPanel = $("#wmp-main-panel");
  const connectBtn = $("#wmp-connect-btn");
  const disconnectBtn = $("#wmp-disconnect-btn");
  const usernameEl = $("#wmp-username");
  const planEl = $("#wmp-plan");
  const artImg = $<HTMLImageElement>("#wmp-art");
  const artPlaceholder = $("#wmp-art-placeholder");
  const trackNameEl = $("#wmp-track-name");
  const artistNameEl = $("#wmp-artist-name");
  const deviceNameEl = $("#wmp-device-name");
  const progressInput = $<HTMLInputElement>("#wmp-progress");
  const timeCurrentEl = $("#wmp-time-current");
  const timeTotalEl = $("#wmp-time-total");
  const playPauseBtn = $("#wmp-playpause");
  const prevBtn = $("#wmp-prev");
  const nextBtn = $("#wmp-next");
  const volumeSlider = $<HTMLInputElement>("#wmp-volume-slider");
  const statusEl = $("#wmp-status");
  const searchInput = $<HTMLInputElement>("#wmp-search-input");
  const resultsList = $("#wmp-search-results");
  const collapseBtn = $("#wmp-collapse");
  const lyricsBtn = $("#wmp-lyrics-btn");
  const lyricsPanel = $("#wmp-lyrics-panel");
  const lyricsStatus = $("#wmp-lyrics-status");
  const lyricsBody = $("#wmp-lyrics-body");
  const titlebar = $(".wmp-titlebar");
  const player = $("#retro-player");
  const fab = $("#wmp-fab");

  let pollHandle: number | null = null;
  let userIsDraggingProgress = false;
  let currentDurationMs = 0;

  // --- Estado de las letras sincronizadas ---
  let lyricsLines: LyricLine[] = [];
  let lyricsKey = "";
  let lyricsActiveIndex = -1;
  // Últimos datos de reproducción conocidos, para estimar el progreso entre polls
  let lastProgressMs = 0;
  let lastPollAt = 0;
  let lastPlaying = false;

  // --- Mostrar / ocultar reproductor con el botón flotante ---
  // En móvil se abre centrado sobre el FAB (donde se pulsó), dentro del
  // viewport. En escritorio vuelve al CSS: arriba a la derecha.
  const PLAYER_POS_KEY = "wmp-player-pos";

  function savePlayerPos() {
    const left = /^(\d+)px$/.exec(player.style.left || "");
    const top = /^(\d+)px$/.exec(player.style.top || "");
    if (!left || !top) return;
    try {
      localStorage.setItem(
        PLAYER_POS_KEY,
        JSON.stringify({ left: Number(left[1]), top: Number(top[1]) })
      );
    } catch {
      // almacenamiento no disponible: ignorar
    }
  }

  function loadPlayerPos(): { left: number; top: number } | null {
    try {
      const raw = localStorage.getItem(PLAYER_POS_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (
        parsed &&
        typeof parsed.left === "number" &&
        typeof parsed.top === "number"
      ) {
        return { left: parsed.left, top: parsed.top };
      }
    } catch {
      // almacenamiento corrupto o no disponible
    }
    return null;
  }

  function setPlayerVisible(visible: boolean) {
    if (visible) {
      const edge = 8;
      const playerWidth = player.offsetWidth;
      const playerHeight = player.offsetHeight;
      const maxX = window.innerWidth - playerWidth - edge;
      const maxY = window.innerHeight - playerHeight - edge;
      const saved = loadPlayerPos();
      const isMobile = window.matchMedia("(max-width: 640px)").matches;

      if (saved) {
        // El usuario ya movió el reproductor: restaurar su última posición
        player.style.left = `${Math.max(edge, Math.min(maxX, saved.left))}px`;
        player.style.top = `${Math.max(edge, Math.min(maxY, saved.top))}px`;
        player.style.right = "auto";
        player.style.bottom = "auto";
      } else if (isMobile) {
        // Centra el reproductor sobre el FAB y lo mantiene dentro del viewport
        const fabRect = fab.getBoundingClientRect();
        const left = Math.max(
          edge,
          Math.min(maxX, fabRect.left + fabRect.width / 2 - playerWidth / 2)
        );
        const top = Math.max(
          edge,
          Math.min(maxY, fabRect.top + fabRect.height / 2 - playerHeight / 2)
        );
        player.style.left = `${left}px`;
        player.style.top = `${top}px`;
        player.style.right = "auto";
        player.style.bottom = "auto";
      } else {
        // Por defecto en escritorio: arriba a la derecha (CSS)
        player.style.removeProperty("left");
        player.style.removeProperty("top");
        player.style.removeProperty("right");
        player.style.removeProperty("bottom");
      }
      player.classList.remove("wmp-player--hide");
    } else {
      player.classList.add("wmp-player--hide");
    }
    fab.classList.toggle("hidden", visible);
    collapseBtn.setAttribute(
      "aria-label",
      visible ? "Minimizar reproductor" : "Mostrar reproductor"
    );
  }

  let suppressFabClick = false;
  fab.addEventListener("click", () => {
    if (suppressFabClick) {
      suppressFabClick = false;
      return;
    }
    setPlayerVisible(true);
  });

  // --- Arrastrar un elemento por la pantalla (reutilizable) ---
  function enableDrag(handle: HTMLElement, target: HTMLElement) {
    let dragState:
      | { pointerId: number; startX: number; startY: number; originX: number; originY: number; moved: boolean }
      | null = null;

    handle.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 && e.pointerType === "mouse") return;
      if (handle !== target && (e.target as HTMLElement).closest("button")) return;
      dragState = {
        pointerId: e.pointerId,
        startX: e.clientX,
        startY: e.clientY,
        originX: target.offsetLeft,
        originY: target.offsetTop,
        moved: false,
      };
      handle.setPointerCapture(e.pointerId);
    });

    handle.addEventListener("pointermove", (e) => {
      if (!dragState || dragState.pointerId !== e.pointerId) return;
      const dx = e.clientX - dragState.startX;
      const dy = e.clientY - dragState.startY;
      if (Math.abs(dx) + Math.abs(dy) > 4) dragState.moved = true;
      const edge = target === player ? 8 : 0;
      const maxX = Math.max(0, window.innerWidth - target.offsetWidth - edge);
      const maxY = Math.max(0, window.innerHeight - target.offsetHeight - edge);
      const nextLeft = Math.max(edge, Math.min(maxX, dragState.originX + dx));
      const nextTop = Math.max(edge, Math.min(maxY, dragState.originY + dy));
      target.style.left = `${nextLeft}px`;
      target.style.top = `${nextTop}px`;
      target.style.right = "auto";
      target.style.bottom = "auto";
    });

    const endDrag = (e: PointerEvent) => {
      if (!dragState || dragState.pointerId !== e.pointerId) return;
      const wasDrag = dragState.moved;
      dragState = null;
      try {
        handle.releasePointerCapture(e.pointerId);
      } catch {
        // sin captura activa, ignorar
      }
      // Si el usuario arrastró (en vez de pulsar), ignorar el clic siguiente
      if (wasDrag && handle === target) {
        suppressFabClick = true;
      }
      // Recordar dónde dejó el reproductor el usuario
      if (wasDrag && target === player) {
        savePlayerPos();
      }
    };
    handle.addEventListener("pointerup", endDrag);
    handle.addEventListener("pointercancel", endDrag);
  }

  // El reproductor arranca arriba a la derecha (CSS) pero se puede arrastrar
  // por toda la página tanto en escritorio como en móvil.
  enableDrag(titlebar, player);
  enableDrag(fab, fab);

  function formatTime(ms: number): string {
    const totalSec = Math.floor(ms / 1000);
    const m = Math.floor(totalSec / 60);
    const s = totalSec % 60;
    return `${m}:${s.toString().padStart(2, "0")}`;
  }

  function showStatus(message: string, kind: "info" | "error" = "info") {
    statusEl.textContent = message;
    statusEl.dataset.kind = kind;
    statusEl.classList.remove("hidden");
  }
  function clearStatus() {
    statusEl.classList.add("hidden");
    statusEl.textContent = "";
  }

  // --- Letras sincronizadas (LRCLIB) ---
  function setLyricsStatus(message: string) {
    lyricsLines = [];
    lyricsActiveIndex = -1;
    lyricsBody.innerHTML = "";
    lyricsStatus.textContent = message;
    lyricsStatus.classList.remove("hidden");
  }

  async function loadLyrics(track: string, artist: string, durationMs: number) {
    const data = await getSyncedLyrics(track, artist, durationMs);
    if (`${track}\u0000${artist}` !== lyricsKey) return;
    if (!data || (!data.plainText && data.lines.length === 0)) {
      setLyricsStatus("No se encontró letra para esta canción.");
      return;
    }
    if (data.lines.length > 0) {
      lyricsLines = data.lines;
      lyricsStatus.classList.add("hidden");
      lyricsBody.innerHTML = "";
      data.lines.forEach((line, i) => {
        const li = document.createElement("li");
        li.className = "wmp-lyric-line";
        li.textContent = line.text || "…";
        li.dataset.index = String(i);
        lyricsBody.appendChild(li);
      });
      updateLyricHighlight();
    } else if (data.plainText) {
      setLyricsStatus(data.plainText);
    }
  }

  function updateLyricHighlight() {
    if (lyricsLines.length === 0) return;
    const elapsed = lastPlaying ? performance.now() - lastPollAt : 0;
    const progress = lastProgressMs + elapsed;

    let index = 0;
    while (
      index < lyricsLines.length - 1 &&
      lyricsLines[index + 1].timeMs <= progress
    ) {
      index++;
    }
    if (index === lyricsActiveIndex) return;
    lyricsActiveIndex = index;

    const items = lyricsBody.children;
    for (let i = 0; i < items.length; i++) {
      items[i].classList.toggle("active", i === index);
    }
    const active = items[index] as HTMLElement | undefined;
    if (active) active.scrollIntoView({ block: "nearest" });
  }

  function toggleLyrics() {
    const isOpen = !lyricsPanel.classList.contains("hidden");
    lyricsPanel.classList.toggle("hidden", isOpen);
    lyricsBtn.setAttribute("aria-pressed", String(!isOpen));
    lyricsBtn.setAttribute("aria-label", isOpen ? "Mostrar letra" : "Ocultar letra");
    if (!isOpen) updateLyricHighlight();
  }

  function messageForError(err: unknown): string {
    if (err instanceof SpotifyAppError) {
      switch (err.kind) {
        case "no_device":
          return "No hay ningún dispositivo activo. Abre Spotify en un dispositivo.";
        case "no_playback":
          return "No hay ninguna reproducción en curso.";
        case "premium_required":
          return "Esta función requiere una cuenta Spotify Premium.";
        case "missing_scope":
          return "Faltan permisos autorizados para esta acción.";
        case "token_expired":
          return "Tu sesión expiró. Conéctate de nuevo.";
        case "network_error":
          return "Problema de red al hablar con Spotify.";
        default:
          return "Spotify respondió con un error.";
      }
    }
    return "Ocurrió un error inesperado.";
  }

  function setPlayingIcon(playing: boolean) {
    const playIcon = document.getElementById("wmp-icon-play");
    const pauseIcon = document.getElementById("wmp-icon-pause");
    if (playIcon) playIcon.classList.toggle("hidden", playing);
    if (pauseIcon) pauseIcon.classList.toggle("hidden", !playing);
    playPauseBtn.setAttribute("aria-label", playing ? "Pausar" : "Reproducir");
  }

  async function refreshNowPlaying() {
    try {
      const state: PlaybackState | null = await getPlaybackState();
      clearStatus();
      if (!state) {
        trackNameEl.textContent = "Sin reproducción";
        artistNameEl.textContent = "";
        deviceNameEl.textContent = "";
        artImg.classList.add("hidden");
        artPlaceholder.classList.remove("hidden");
        setPlayingIcon(false);
        lastPlaying = false;
        setLyricsStatus("Sin reproducción activa.");
        showStatus("No hay ninguna reproducción en curso.");
        return;
      }
      trackNameEl.textContent = state.trackName || "—";
      artistNameEl.textContent = state.artistNames || "";
      deviceNameEl.textContent = state.deviceName
        ? `Dispositivo: ${state.deviceName}`
        : "Sin dispositivo activo";
      if (!state.deviceName) showStatus("No hay ningún dispositivo activo.");

      if (state.albumImageUrl) {
        artImg.src = state.albumImageUrl;
        artImg.alt = `Portada de ${state.trackName}`;
        artImg.classList.remove("hidden");
        artPlaceholder.classList.add("hidden");
      } else {
        artImg.classList.add("hidden");
        artPlaceholder.classList.remove("hidden");
      }

      currentDurationMs = state.durationMs;
      if (!userIsDraggingProgress) {
        progressInput.value = String(
          state.durationMs > 0
            ? Math.round((state.progressMs / state.durationMs) * 1000)
            : 0
        );
      }
      timeCurrentEl.textContent = formatTime(state.progressMs);
      timeTotalEl.textContent = formatTime(state.durationMs);

      setPlayingIcon(state.isPlaying);

      lastProgressMs = state.progressMs;
      lastPollAt = performance.now();
      lastPlaying = state.isPlaying;

      const key = `${state.trackName}\u0000${state.artistNames}`;
      if (key !== lyricsKey) {
        lyricsKey = key;
        if (state.trackName && state.artistNames) {
          setLyricsStatus("Cargando letra...");
          void loadLyrics(state.trackName, state.artistNames, state.durationMs);
        } else {
          setLyricsStatus("Sin letra disponible.");
        }
      }

      if (state.volumePercent !== null && !document.activeElement?.isSameNode(volumeSlider)) {
        volumeSlider.value = String(state.volumePercent);
      }
    } catch (err) {
      showStatus(messageForError(err), "error");
    }
  }

  function startPolling() {
    stopPolling();
    refreshNowPlaying();
    pollHandle = window.setInterval(refreshNowPlaying, 5000);
  }
  function stopPolling() {
    if (pollHandle !== null) {
      clearInterval(pollHandle);
      pollHandle = null;
    }
  }

  async function showConnectedUI() {
    connectPanel.classList.add("hidden");
    mainPanel.classList.remove("hidden");
    try {
      const me = await getMe();
      usernameEl.textContent = me.display_name || "Usuario";
      planEl.textContent = me.product === "premium" ? "Premium" : "Free";
      if (me.product !== "premium") {
        showStatus(
          "Con cuenta Free solo puedes ver lo que suenas, no controlar la reproducción."
        );
      }
    } catch (err) {
      showStatus(messageForError(err), "error");
    }
    startPolling();
  }

  function showDisconnectedUI() {
    mainPanel.classList.add("hidden");
    connectPanel.classList.remove("hidden");
    stopPolling();
  }

  connectBtn.addEventListener("click", async () => {
    try {
      await startLogin();
    } catch {
      showStatus("No se pudo iniciar la conexión con Spotify.", "error");
    }
  });

  disconnectBtn.addEventListener("click", () => {
    logout();
    showDisconnectedUI();
  });

  playPauseBtn.addEventListener("click", async () => {
    try {
      const state = await getPlaybackState();
      if (state?.isPlaying) {
        await pause();
      } else {
        await play();
      }
      await refreshNowPlaying();
    } catch (err) {
      showStatus(messageForError(err), "error");
    }
  });

  prevBtn.addEventListener("click", async () => {
    try {
      await previousTrack();
      setTimeout(refreshNowPlaying, 400);
    } catch (err) {
      showStatus(messageForError(err), "error");
    }
  });

  nextBtn.addEventListener("click", async () => {
    try {
      await nextTrack();
      setTimeout(refreshNowPlaying, 400);
    } catch (err) {
      showStatus(messageForError(err), "error");
    }
  });

  progressInput.addEventListener("pointerdown", () => {
    userIsDraggingProgress = true;
  });
  progressInput.addEventListener("change", async () => {
    userIsDraggingProgress = false;
    try {
      const ratio = Number(progressInput.value) / 1000;
      await seek(ratio * currentDurationMs);
      setTimeout(refreshNowPlaying, 300);
    } catch (err) {
      showStatus(messageForError(err), "error");
    }
  });

  let volumeDebounce: number | null = null;
  volumeSlider.addEventListener("input", () => {
    if (volumeDebounce) clearTimeout(volumeDebounce);
    volumeDebounce = window.setTimeout(async () => {
      try {
        await setVolume(Number(volumeSlider.value));
      } catch (err) {
        showStatus(messageForError(err), "error");
      }
    }, 250);
  });

  let searchDebounce: number | null = null;
  searchInput.addEventListener("input", () => {
    if (searchDebounce) clearTimeout(searchDebounce);
    const query = searchInput.value;
    searchDebounce = window.setTimeout(async () => {
      resultsList.innerHTML = "";
      if (!query.trim()) return;
      try {
        const results = await searchTracks(query);
        for (const track of results) {
          const li = document.createElement("li");
          li.setAttribute("role", "button");
          li.tabIndex = 0;

          if (track.albumImageUrl) {
            const img = document.createElement("img");
            img.src = track.albumImageUrl;
            img.alt = "";
            img.width = 20;
            img.height = 20;
            li.appendChild(img);
          }

          const titleSpan = document.createElement("span");
          titleSpan.className = "wmp-result-title";
          titleSpan.textContent = `${track.name} — ${track.artistNames}`;
          li.appendChild(titleSpan);

          const activate = async () => {
            try {
              await play(track.uri);
              setTimeout(refreshNowPlaying, 400);
            } catch (err) {
              showStatus(messageForError(err), "error");
            }
          };
          li.addEventListener("click", activate);
          li.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              activate();
            }
          });

          resultsList.appendChild(li);
        }
      } catch (err) {
        showStatus(messageForError(err), "error");
      }
    }, 400);
  });

  collapseBtn.addEventListener("click", () => setPlayerVisible(false));
  lyricsBtn.addEventListener("click", toggleLyrics);

  // Resalta la línea de letra activa según el progreso estimado
  window.setInterval(updateLyricHighlight, 500);

  // Estado inicial: en móvil el reproductor arranca oculto (solo el FAB).
  // En escritorio se muestra y, si el usuario ya lo movió, restaura su posición.
  if (window.matchMedia("(max-width: 640px)").matches) {
    setPlayerVisible(false);
  } else {
    setPlayerVisible(true);
  }

  if (isConnected()) {
    showConnectedUI();
  } else {
    showDisconnectedUI();
  }
</script>
