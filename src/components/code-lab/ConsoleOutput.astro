---
export interface Props {
  output?: string;
  warning?: string;
}

const { output, warning } = Astro.props;
const consoleId = `console-${Math.random().toString(36).slice(2, 6)}`;
---

<div class="console-output" id={consoleId} role="region" aria-label="Consola de salida">
  <div class="console-output__warning" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
    <span>⚠️ Modo de práctica — los resultados son de ejemplo. La ejecución real de Java no está disponible en esta versión.</span>
  </div>
  <div class="console-output__lines">
    {output ? output.split('\n').map((line) => (
      <div class="console-output__line">{line}</div>
    )) : (
      <div class="console-output__line console-output__line--muted">// Haz clic en "Ejecutar" para ver la salida simulada</div>
    )}
  </div>
</div>

<style>
  .console-output {
    background: var(--console-bg);
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    min-height: 150px;
    max-height: 250px;
    overflow-y: auto;
    color: var(--console-text);
    text-shadow: 0 0 4px var(--console-glow);
  }

  .console-output__warning {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 179, 71, 0.1);
    border: 1px solid rgba(255, 179, 71, 0.3);
    border-radius: var(--radius-sm);
    color: var(--warning);
    font-size: var(--text-xs);
    margin-bottom: var(--space-md);
    line-height: 1.5;
  }

  .console-output__warning svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .console-output__lines {
    padding-top: var(--space-sm);
  }

  .console-output__line {
    padding: 1px 0;
    white-space: pre-wrap;
  }

  .console-output__line--muted {
    color: var(--line);
    font-style: italic;
  }
</style>
