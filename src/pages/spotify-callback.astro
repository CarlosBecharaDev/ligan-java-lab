---
// src/pages/spotify-callback.astro
// Toda la lógica OAuth vive en src/lib/spotify.ts. Esta página solo la invoca.
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Conectando con Spotify...">
  <main class="callback-screen">
    <div class="callback-box">
      <p id="callback-status" data-i18n="callback.connecting">Conectando con Spotify...</p>
      <button id="callback-back" class="hidden" type="button" data-i18n="callback.back">Volver</button>
    </div>
  </main>
</BaseLayout>

<style>
  .callback-screen {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Perfect DOS VGA 437", "MS Sans Serif", monospace;
  }
  .callback-box {
    background: #0a0a0a;
    color: #1ed760;
    border: 2px solid #1ed760;
    box-shadow: 4px 4px 0 #000;
    padding: 1.5rem 2rem;
    text-align: center;
  }
  .callback-box p[data-error="true"] {
    color: #ff5f57;
  }
  .hidden {
    display: none;
  }
  button {
    margin-top: 1rem;
    background: #0a0a0a;
    color: #ffd700;
    border: 2px solid #ffd700;
    padding: 0.4rem 1rem;
    cursor: pointer;
    font-family: inherit;
  }
</style>

<script>
  import { handleAuthCallback } from "../lib/spotify";

  const statusEl = document.getElementById("callback-status")!;
  const backBtn = document.getElementById("callback-back")!;

  const T = (key: string): string =>
    ((window as any).__i18n && (window as any).__i18n.t(key)) || key;

  (async () => {
    try {
      const params = new URLSearchParams(window.location.search);
      await handleAuthCallback(params);
      statusEl.textContent = T("callback.connected");
      window.location.replace("/");
    } catch (err: any) {
      statusEl.setAttribute("data-error", "true");
      statusEl.textContent =
        err?.message || T("callback.error");
      backBtn.classList.remove("hidden");
      backBtn.addEventListener("click", () => window.location.replace("/"));
    }
  })();
</script>
