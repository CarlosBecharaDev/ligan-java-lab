---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;padding:var(--space-xl);text-align:center;background:var(--bg);color:var(--text);font-family:var(--font-ui)">
    
    <div style="background:var(--win-bg);border:2px solid var(--win-border);box-shadow:4px 4px 0 rgba(0,0,0,0.5);width:100%;max-width:600px;text-align:left;display:flex;flex-direction:column">
      
      <!-- Title bar -->
      <div style="background:#808098;color:white;padding:6px 8px;font-family:var(--font-pixel);font-size:12px;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--win-border)">
        <span data-i18n="404.title">Error_404.exe</span>
        <div style="display:flex;gap:6px">
          <div style="width:12px;height:12px;border-radius:50%;background:var(--win-close);border:1px solid #333"></div>
          <div style="width:12px;height:12px;border-radius:50%;background:var(--win-minimize);border:1px solid #333"></div>
          <div style="width:12px;height:12px;border-radius:50%;background:var(--win-maximize);border:1px solid #333"></div>
        </div>
      </div>
      
      <!-- Window Content -->
      <div style="padding:var(--space-xl);display:flex;flex-direction:column;align-items:center;color:var(--win-text);background:var(--win-bg)">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--win-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:var(--space-md)">
          <polyline points="16 18 22 12 16 6" />
          <polyline points="8 6 2 12 8 18" />
        </svg>

        <h1 style="font-family:var(--font-pixel);font-size:32px;margin-bottom:var(--space-md);color:var(--win-text)">404</h1>
        <p data-i18n="404.msg1" style="color:var(--win-muted);margin-bottom:var(--space-sm);font-family:var(--font-ui);font-size:var(--text-xl)">
          Esta página no existe en el laboratorio.
        </p>
        <p data-i18n="404.msg2" style="color:var(--win-muted);margin-bottom:var(--space-xl);font-family:var(--font-ui);font-size:var(--text-lg)">
          Java lanza una excepción cuando algo no se encuentra. Aquí pasa igual.
        </p>

        <div style="background:#0A0A0A;color:#C0C0C0;border:2px solid #555;padding:var(--space-md);margin-bottom:var(--space-xl);font-family:var(--font-mono);font-size:var(--text-sm);text-align:left;width:100%;box-shadow:inset 2px 2px 0 rgba(0,0,0,0.8)">
          <div style="color:var(--danger)">C:\> java Ruta.java</div>
          <div style="color:var(--danger)">Exception in thread "main" java.lang.ClassNotFoundException: Ruta.noEncontrada</div>
          <div style="color:var(--warning)">  at java.base/jdk.internal.loader.BuiltinClassLoader.loadClass(BuiltinClassLoader.java:641)</div>
          <div style="color:var(--warning)">  at Usuario.navegó(Usuario.java:404)</div>
          <div style="color:var(--muted)">...</div>
          <div data-i18n="404.suggestion" style="color:var(--success);margin-top:8px">> Sugerencia: verifica la URL o vuelve al escritorio</div>
        </div>

        <a href="/" style="display:inline-flex;align-items:center;gap:var(--space-sm);padding:8px 16px;background:#C0C0C0;color:black;border:2px solid;border-color:white #555 #555 white;font-family:var(--font-pixel);font-size:12px;text-decoration:none;cursor:pointer;box-shadow:2px 2px 0 rgba(0,0,0,0.3)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
          <span data-i18n="404.back">Volver al escritorio</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
